<!DOCTYPE html>
<html>

<head>
    <title>Even Numbers Sum</title>
</head>

<body>

    <button onclick="calculateEvenSum()">Click me</button>

    <script>

        function calculateEvenSum() {

            let numbers = [];

            for (let i = 0; i <= 100; i++) {
                numbers.push(i);
            }

            let sum = 0;

            for (let i = 0; i < numbers.length; i++) {

                if (numbers[i] % 2 === 0) {
                    sum += numbers[i];
                }

            }

            console.log("Even Numbers Sum =", sum);

        }

    </script>

</body>

</html>